# Groq — free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here
LLM_MODEL=openai/gpt-oss-120b

# Qdrant — pick ONE mode
#   embedded = runs inside Python, writes to ./qdrant_storage, no Docker needed
#   cloud    = Qdrant Cloud free tier (recommended for your demo)
#   server   = your own Docker container
QDRANT_MODE=embedded
QDRANT_COLLECTION=medibot_chunks

# Only needed for cloud/server mode:
QDRANT_URL=https://xxxx-xxxx.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=

# Auth
JWT_SECRET=pick-any-long-random-string
